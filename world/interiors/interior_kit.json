{
	"_what": "Furniture kit and room recipes for world/interiors/interior_furnisher.gd. Sizes come from world/props/household/manifest.json (suggested_size_m); every prop faces +Z with its back at -Z. The furnisher seeds each house from its place_id, so a house always gets the same layout and every house gets its own.",
	"_rules": {
		"wall": "back against a real wall (measured), front into the room. Tall props keep off windows.",
		"island": "free-standing, with an aisle all round; falls back to a wall if the area is too small. Not used by the recipes since dev 2026-09-26: the island reads as a cupboard block in the middle of the house; it stands against a wall like a counter.",
		"face": "in front of the anchor at a distance, turned to face it (sofa facing the fireplace).",
		"front": "centred in front of the anchor, same heading (coffee table before the sofa).",
		"between": "flat, centred between the anchor and what it faces (rug between sofa and fireplace).",
		"flank": "beside the anchor, turned in toward the space in front of it (armchair by the sofa).",
		"bedside": "beside a bed's headboard, back to the same wall.",
		"bedrug": "flat, along the open side of a bed or across its foot.",
		"under_window": "a low prop on the floor under a window.",
		"open": "free-standing small piece with room around it.",
		"hang": "on a wall at eye height, clear of windows and tall furniture.",
		"curtains": "one pair per ground-floor window, by chance.",
		"door": "flat, just inside the front door.",
		"bedfoot": "a bench across the foot of a bed, facing the room.",
		"on": "decor laid on its anchor (offset from the kit 'on' table), no collision.",
		"ceiling": "a pendant from the real ceiling over its anchor table (or the room centre with 2.05 m headroom)."
	},
